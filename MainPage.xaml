<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:networkMind="clr-namespace:NetworkMind"
             x:Class="NetworkMind.MainPage">

    <Grid RowDefinitions="Auto, *" Padding="20"
          HorizontalOptions="FillAndExpand"
          VerticalOptions="FillAndExpand">
        
        <!-- Фоновое изображение -->
        <Image Source="background.jpg"
               Aspect="AspectFill"
               Opacity="0.5"
               HorizontalOptions="FillAndExpand"
               VerticalOptions="FillAndExpand"
               Grid.RowSpan="2"/>

        <!-- Заголовок -->
        <Label Text="Соедините одинаковые порты!"
               FontSize="20"
               HorizontalOptions="Center"
               Grid.Row="0"/>
        
        <!-- Кнопка "Проверить" -->
        <Button Text="Проверить"
                FontSize="18"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                Grid.Row="0"
                Margin="0,40,0,0"
                Clicked="CheckBtn_Clicked"/>

        <!-- Контейнер с двумя коммутаторами -->
        <StackLayout Orientation="Vertical"
                     Spacing="50"
                     HorizontalOptions="Center"
                     Grid.Row="1">

            <!-- Коммутатор 1 -->
            <Grid x:Name="Switch1Container" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                <Image Source="switch1.png" WidthRequest="500" HorizontalOptions="Fill" VerticalOptions="FillAndExpand"/>
                <!-- Точки -->
                <Grid x:Name="Switch1ContainerDots" VerticalOptions="Center" Margin="60, 0, 0, 0">
                    <!-- Первая строка из 9 красных точек -->
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Текст -->
                    <Label Grid.Row="0" Grid.Column="0" WidthRequest="20" HeightRequest="20">*</Label>
                    <Label Grid.Row="0" Grid.Column="1" WidthRequest="20" HeightRequest="20">*</Label>
                    <Label Grid.Row="0" Grid.Column="2" WidthRequest="20" HeightRequest="20">*</Label>
                    <Label Grid.Row="0" Grid.Column="3" WidthRequest="20" HeightRequest="20">*</Label>
                    <Label Grid.Row="0" Grid.Column="4" WidthRequest="20" HeightRequest="20">*</Label>
                    <Label Grid.Row="0" Grid.Column="5" WidthRequest="20" HeightRequest="20">*</Label>
                    <Label Grid.Row="0" Grid.Column="6" WidthRequest="20" HeightRequest="20">*</Label>
                    <Label Grid.Row="0" Grid.Column="7" WidthRequest="20" HeightRequest="20">*</Label>
                    <Label Grid.Row="0" Grid.Column="8" WidthRequest="20" HeightRequest="20">*</Label>
                    
                    <!-- Первая строка -->
                    <Ellipse Grid.Row="1" Grid.Column="0" WidthRequest="20" HeightRequest="20" Fill="Red"/>
                    <Ellipse Grid.Row="1" Grid.Column="1" WidthRequest="20" HeightRequest="20" Fill="Red"/>
                    <Ellipse Grid.Row="1" Grid.Column="2" WidthRequest="20" HeightRequest="20" Fill="Red"/>
                    <Ellipse Grid.Row="1" Grid.Column="3" WidthRequest="20" HeightRequest="20" Fill="Red"/>
                    <Ellipse Grid.Row="1" Grid.Column="4" WidthRequest="20" HeightRequest="20" Fill="Red"/>
                    <Ellipse Grid.Row="1" Grid.Column="5" WidthRequest="20" HeightRequest="20" Fill="Red"/>
                    <Ellipse Grid.Row="1" Grid.Column="6" WidthRequest="20" HeightRequest="20" Fill="Red"/>
                    <Ellipse Grid.Row="1" Grid.Column="7" WidthRequest="20" HeightRequest="20" Fill="Red"/>
                    <Ellipse Grid.Row="1" Grid.Column="8" WidthRequest="20" HeightRequest="20" Fill="Red"/>

                    <!-- Вторая строка -->
                    <Ellipse Grid.Row="2" Grid.Column="0" WidthRequest="20" HeightRequest="20" Fill="Red"/>
                    <Ellipse Grid.Row="2" Grid.Column="1" WidthRequest="20" HeightRequest="20" Fill="Red"/>
                    <Ellipse Grid.Row="2" Grid.Column="2" WidthRequest="20" HeightRequest="20" Fill="Red"/>
                    <Ellipse Grid.Row="2" Grid.Column="3" WidthRequest="20" HeightRequest="20" Fill="Red"/>
                    <Ellipse Grid.Row="2" Grid.Column="4" WidthRequest="20" HeightRequest="20" Fill="Red"/>
                    <Ellipse Grid.Row="2" Grid.Column="5" WidthRequest="20" HeightRequest="20" Fill="Red"/>
                    <Ellipse Grid.Row="2" Grid.Column="6" WidthRequest="20" HeightRequest="20" Fill="Red"/>
                    <Ellipse Grid.Row="2" Grid.Column="7" WidthRequest="20" HeightRequest="20" Fill="Red"/>
                    <Ellipse Grid.Row="2" Grid.Column="8" WidthRequest="20" HeightRequest="20" Fill="Red"/>
                </Grid>
            </Grid>

            <!-- Коммутатор 2 -->
            <Grid x:Name="Switch2Container" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                <Image Source="switch1.png" WidthRequest="500" HorizontalOptions="Fill" VerticalOptions="FillAndExpand"/>
                <!-- Точки -->
                <Grid x:Name="Switch2ContainerDots" VerticalOptions="Center" Margin="60, 0, 0, 0">
                    <!-- Первая строка из 9 красных точек -->
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Текст -->
                    <Label Grid.Row="0" Grid.Column="0" WidthRequest="20" HeightRequest="20">*</Label>
                    <Label Grid.Row="0" Grid.Column="1" WidthRequest="20" HeightRequest="20">*</Label>
                    <Label Grid.Row="0" Grid.Column="2" WidthRequest="20" HeightRequest="20">*</Label>
                    <Label Grid.Row="0" Grid.Column="3" WidthRequest="20" HeightRequest="20">*</Label>
                    <Label Grid.Row="0" Grid.Column="4" WidthRequest="20" HeightRequest="20">*</Label>
                    <Label Grid.Row="0" Grid.Column="5" WidthRequest="20" HeightRequest="20">*</Label>
                    <Label Grid.Row="0" Grid.Column="6" WidthRequest="20" HeightRequest="20">*</Label>
                    <Label Grid.Row="0" Grid.Column="7" WidthRequest="20" HeightRequest="20">*</Label>
                    <Label Grid.Row="0" Grid.Column="8" WidthRequest="20" HeightRequest="20">*</Label>
                    
                    <!-- Первая строка -->
                    <Ellipse Grid.Row="1" Grid.Column="0" WidthRequest="20" HeightRequest="20" Fill="Red"/>
                    <Ellipse Grid.Row="1" Grid.Column="1" WidthRequest="20" HeightRequest="20" Fill="Red"/>
                    <Ellipse Grid.Row="1" Grid.Column="2" WidthRequest="20" HeightRequest="20" Fill="Red"/>
                    <Ellipse Grid.Row="1" Grid.Column="3" WidthRequest="20" HeightRequest="20" Fill="Red"/>
                    <Ellipse Grid.Row="1" Grid.Column="4" WidthRequest="20" HeightRequest="20" Fill="Red"/>
                    <Ellipse Grid.Row="1" Grid.Column="5" WidthRequest="20" HeightRequest="20" Fill="Red"/>
                    <Ellipse Grid.Row="1" Grid.Column="6" WidthRequest="20" HeightRequest="20" Fill="Red"/>
                    <Ellipse Grid.Row="1" Grid.Column="7" WidthRequest="20" HeightRequest="20" Fill="Red"/>
                    <Ellipse Grid.Row="1" Grid.Column="8" WidthRequest="20" HeightRequest="20" Fill="Red"/>

                    <!-- Вторая строка -->
                    <Ellipse Grid.Row="2" Grid.Column="0" WidthRequest="20" HeightRequest="20" Fill="Red"/>
                    <Ellipse Grid.Row="2" Grid.Column="1" WidthRequest="20" HeightRequest="20" Fill="Red"/>
                    <Ellipse Grid.Row="2" Grid.Column="2" WidthRequest="20" HeightRequest="20" Fill="Red"/>
                    <Ellipse Grid.Row="2" Grid.Column="3" WidthRequest="20" HeightRequest="20" Fill="Red"/>
                    <Ellipse Grid.Row="2" Grid.Column="4" WidthRequest="20" HeightRequest="20" Fill="Red"/>
                    <Ellipse Grid.Row="2" Grid.Column="5" WidthRequest="20" HeightRequest="20" Fill="Red"/>
                    <Ellipse Grid.Row="2" Grid.Column="6" WidthRequest="20" HeightRequest="20" Fill="Red"/>
                    <Ellipse Grid.Row="2" Grid.Column="7" WidthRequest="20" HeightRequest="20" Fill="Red"/>
                    <Ellipse Grid.Row="2" Grid.Column="8" WidthRequest="20" HeightRequest="20" Fill="Red"/>
                </Grid>
            </Grid>

        </StackLayout>

        <!-- Canvas для рисования -->
        <networkMind:LineDrawingView x:Name="LineCanvas"
                               HorizontalOptions="FillAndExpand"
                               VerticalOptions="FillAndExpand"
                               Grid.RowSpan="2"
                               InputTransparent="True"/>
        
    </Grid>

</ContentPage>